rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function callerUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerRole() {
      return (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? callerUserDoc().data.userType
        : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        callerRole() == 'admin'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.role in ['admin', 'librarian'] ||
        callerRole() in ['admin', 'librarian']
      );
    }

    // Projects collection (Public read; Admin create/delete; Staff metadata updates; safe saveCount toggles)
    match /projects/{projectId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isStaff() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saveCount']) &&
        request.resource.data.saveCount is number
      );
    }

    // Pending Librarian submissions awaiting Administrator approval
    match /pendingProjects/{projectId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Physical cataloging metadata notes
    match /catalogNotes/{projectId} {
      allow read, write: if isStaff();
    }

    // Librarian edit grants issued by Administrator
    match /librarianEditPermissions/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isStaff() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editingStarted', 'editCompleted'])
      );
    }

    // Users collection (Self-updates cannot modify role, locked institutional IDs, or moderation fields)
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userType', 'role', 'studentId', 'teacherId', 'idNumber', 'employeeId',
          'idVerification', 'idCardVerified', 'status', 'suspensionReason',
          'suspendedDuration', 'authProviders', 'uid', 'email'
        ])
      );
    }

    // Institutional ID Uniqueness Lock Registry (Server Admin SDK only — blocks client spoofing)
    match /registeredIds/{idKey} {
      allow read, write: if false;
    }

    // Users Saved Projects (Owners read/write; Admin read for Top Bookmarked analytics)
    match /usersSavedProjects/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // NOTE: User Activities are strictly stored on the owner's local device (localStorage)
    // to preserve Firestore Spark free-tier quotas (avoiding write/read bursting).

    // Conversations & AI chat history (Owner-scoped)
    match /conversations/{conversationId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Admin system configuration
    match /system_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Physical shelf location accountability audit logs
    match /physicalLocationAccessLogs/{logId} {
      allow create: if request.resource.data.agreed == true && (
        (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (!isSignedIn() && request.resource.data.userId == 'guest-session')
      );
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Deny all unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
