rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }
    
    // Users Saved Projects
    match /usersSavedProjects/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User Activities: accessible by owner or admin
    match /userActivities/{activityId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
    }
    
    // Conversations & AI chat history
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
    }
    
    // Default catch-all for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
